@model IEnumerable<LabWebApi.Models.Student>

<h2>Students Older Than 18</h2>
<table class="table">
    <thead>
        <tr>
            <th>StudentId</th>
            <th>Name</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Age</td>
            </tr>
        }
    </tbody>
</table>
<p><a href="Index">Back to Student List</a></p>


